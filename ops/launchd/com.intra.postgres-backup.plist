<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.intra.postgres-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/marselkei/VS/intra/venv/bin/python</string>
        <string>/Users/marselkei/VS/intra/scripts/runtime/backup/paper_database.py</string>
        <string>--keep</string><string>30</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/marselkei/VS/intra</string>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
    <!-- Local Mac time: 16:45 Pacific is after the equity session. -->
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key><string>/Users/marselkei/VS/intra/logs/postgres_backup.log</string>
    <key>StandardErrorPath</key><string>/Users/marselkei/VS/intra/logs/postgres_backup.log</string>
</dict>
</plist>
