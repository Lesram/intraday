<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.intra.paper.daily-evidence</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/marselkei/VS/intra/venv/bin/python</string>
        <string>-B</string>
        <string>/Users/marselkei/VS/intra/scripts/ops/paper_daily_host.py</string>
        <string>--binding</string>
        <string>/Users/marselkei/Library/Application Support/Intra/daily-evidence-binding.json</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/marselkei/VS/intra</string>
    <key>EnvironmentVariables</key>
    <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/Applications/Docker.app/Contents/Resources/bin:/usr/bin:/bin</string></dict>
    <!-- 13:10 Pacific: 20:10 UTC in PDT, 21:10 UTC in PST. The broker calendar
         still enforces actual session close plus five minutes and holidays. -->
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>10</integer></dict>
    <key>RunAtLoad</key><false/>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>/Users/marselkei/Library/Application Support/Intra/daily-evidence-job.log</string>
    <key>StandardErrorPath</key><string>/Users/marselkei/Library/Application Support/Intra/daily-evidence-job.log</string>
</dict>
</plist>
