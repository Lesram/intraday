# Staging Environment Configuration
# NOTE: Secrets are not committed; sourced from your secret manager in CI

# Application Configuration
APP_ENV=staging
APP_HOST=0.0.0.0
APP_PORT=8000

# Data Sources Configuration
USE_MOCK_DATA=false
USE_MOCK_BROKER=true

# Alpaca Trading Configuration (Paper Trading for Staging)
ALPACA_PAPER=true
ALPACA_API_KEY_ID=__set_in_secret_store__
ALPACA_API_SECRET_KEY=__set_in_secret_store__
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/trading

# CORS Configuration for UI
APP_CORS_ORIGINS=https://staging.your-ui.tld,https://localhost:3000

# Security Configuration
SECURITY_JWT_SECRET=__set_in_secret_store__
SECURITY_JWT_EXPIRE_MINUTES=60
JWT_ISS=algotrading-platform
JWT_AUD=algotrading-api

# Staging API Key (for smoke tests only - NOT FOR PRODUCTION)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STAGING_API_KEY=__generate_long_random__