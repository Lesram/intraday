+def _module_identity(module):
+    """Loaded source identity, including known scalar/container constants.
+
+    This cache is process-local, never persisted across deployments. Replaced
+    functions, changed code objects, defaults or constants invalidate it;
+    closures/foreign wrappers are unknown mutable computation and bypass it.
+    """
+    functions, constants, libraries = [], {}, []
+    for name, value in sorted(vars(module).items()):
+        if name.startswith("__"):
+            continue
+        if isinstance(value, FunctionType):
+            if value.__module__ != module.__name__ or value.__closure__:
+                return None
+            defaults = json.dumps((value.__defaults__, value.__kwdefaults__), sort_keys=True, allow_nan=False)
+            functions.append((name, value, value.__code__, defaults))
+        elif value is None or type(value) in (str, int, float, bool, list, tuple, dict):
+            constants[name] = value
+        elif isinstance(value, ModuleType):
+            libraries.append((name, id(value), getattr(value, "__version__", None)))
+        elif name == "Any" and value is Any:
+            libraries.append((name, id(value), None))
+        elif name == "annotations" and value is __future__.annotations:
+            continue  # Compiler metadata, never a feature computation input.
+        else:
+            return None  # Unknown mutable module state is not a cache input.
+    return tuple(functions), tuple(libraries), json.dumps(constants, sort_keys=True, allow_nan=False)
+
