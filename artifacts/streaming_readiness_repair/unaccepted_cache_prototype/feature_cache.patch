+class _MLFeatureCache:
+    """One owned ML frame per symbol; no decisions, source data or QA cached."""
+
+    DEFAULT_MAX_ENTRIES = 128
+    DEFAULT_MAX_BYTES = 64 * 1024 * 1024
+
+    def __init__(self, max_entries=None, max_bytes=None):
+        self.max_entries = self.DEFAULT_MAX_ENTRIES if max_entries is None else max_entries
+        self.max_bytes = self.DEFAULT_MAX_BYTES if max_bytes is None else max_bytes
+        self._entries = OrderedDict()
+        self._bytes = 0
+        self._lock = threading.Lock()
+        self.reset_counts()
+
+    def reset_counts(self):
+        with self._lock:
+            self._counts = {"hits": 0, "misses": 0, "bypasses": 0}
+
+    def get(self, symbol, key, raw, spy):
+        with self._lock:
+            if key is None:
+                self._counts["bypasses"] += 1
+                return None
+            item = self._entries.get(symbol)
+            if item is not None and item[0] == key and item[1].equals(raw) and (
+                (spy is None and item[2] is None) or (spy is not None and item[2] is not None and item[2].equals(spy))
+            ):
+                self._entries.move_to_end(symbol)
+                self._counts["hits"] += 1
+                return item[3].copy(deep=True)
+            self._counts["misses"] += 1
+            return None
+
+    def put(self, symbol, key, raw, spy, features):
+        if key is None or _frame_identity(features) is None:
+            return
+        size = sum(int(frame.memory_usage(index=True, deep=True).sum())
+                   for frame in (raw, spy, features) if frame is not None)
+        with self._lock:
+            prior = self._entries.pop(symbol, None)
+            if prior is not None:
+                self._bytes -= prior[4]
+            if size > self.max_bytes or self.max_entries <= 0:
+                return
+            while self._entries and (len(self._entries) >= self.max_entries or self._bytes + size > self.max_bytes):
+                _, removed = self._entries.popitem(last=False)
+                self._bytes -= removed[4]
+            self._entries[symbol] = (key, raw.copy(deep=True), None if spy is None else spy.copy(deep=True),
+                                     features.copy(deep=True), size)
+            self._bytes += size
+
+    def prune(self, retained):
+        with self._lock:
+            for symbol in set(self._entries) - set(retained):
+                self._bytes -= self._entries.pop(symbol)[4]
+
+    def clear(self):
+        self.prune(set())
+
+    def symbols(self):
+        with self._lock:
+            return set(self._entries)
+
+    def snapshot(self):
+        with self._lock:
+            return {**self._counts, "entries": len(self._entries), "dataframe_bytes": self._bytes}
 
 
