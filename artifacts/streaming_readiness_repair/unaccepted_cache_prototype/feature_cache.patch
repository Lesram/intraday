+def _frame_identity(frame):
+    """Content key for supported immutable scalar cells; unknown data bypasses.
+
+    Equality against retained input copies additionally guards hash collisions.
+    Pandas deep copies do not clone arbitrary Python objects, so those are never
+    admitted. Index type/names/dtype/frequency and column order are part of the
+    identity, not merely the newest timestamp or number of rows.
+    """
+    if frame is None:
+        return "none"
+    if type(frame) is not pd.DataFrame or frame.attrs or frame.empty:
+        return None
+    if len(frame) > 2000 or len(frame.columns) > 512 or isinstance(frame.index, pd.MultiIndex):
+        return None
+    if type(frame.index) not in (pd.Index, pd.RangeIndex, pd.DatetimeIndex):
+        return None
+    if not frame.columns.is_unique or not all(type(name) is str for name in frame.columns):
+        return None
+    try:
+        index_dtype = frame.index.dtype
+        if pd.api.types.is_object_dtype(index_dtype) or pd.api.types.is_string_dtype(index_dtype):
+            if not all(type(value) is str for value in frame.index):
+                return None
+        elif not (pd.api.types.is_numeric_dtype(index_dtype) or pd.api.types.is_datetime64_any_dtype(index_dtype)):
+            return None
+        for name, dtype in frame.dtypes.items():
+            if pd.api.types.is_object_dtype(dtype) or pd.api.types.is_string_dtype(dtype):
+                if not all(type(value) is str for value in frame[name]):
+                    return None
+            elif not (pd.api.types.is_numeric_dtype(dtype) or pd.api.types.is_datetime64_any_dtype(dtype)):
+                return None
+        metadata = json.dumps({
+            "columns": list(frame.columns), "column_names": list(frame.columns.names),
+            "dtypes": [str(dtype) for dtype in frame.dtypes],
+            "index_type": type(frame.index).__name__, "index_dtype": str(frame.index.dtype),
+            "index_names": list(frame.index.names), "index_frequency": str(getattr(frame.index, "freq", None)),
+        }, sort_keys=True, allow_nan=False).encode()
+        values = pd.util.hash_pandas_object(frame, index=True).values.tobytes()
+        return hashlib.sha256(metadata + values).digest()
+    except (TypeError, ValueError, ArithmeticError, RecursionError):
+        return None
+
