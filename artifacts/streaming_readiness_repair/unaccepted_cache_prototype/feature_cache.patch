+            if set(vars(store)) != {"_config", "_sessionmaker", "_config_hash", "_engineer"}:
+                return None
+            if set(vars(store._engineer)) != {"logger", "settings", "config"}:
+                return None
+            config = [store._config, store._engineer.config]
+            store_identity = (id(store), id(store._engineer), type(store).compute_features,
+                              type(store._engineer).compute_technical_indicators)
+        settings = json.dumps({"bars_per_day": engine._bars_per_day,
+                               "timeframe": os.getenv("ORGANISM_LIVE_TIMEFRAME", "1Day"),
+                               "engine_timeframe": getattr(engine, "_timeframe", None),
