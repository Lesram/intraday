{
  "monitoring_checklist": {
    "first_30_minutes": {
      "checks": [
        "Verify organism is running: check Docker container 'api' is up",
        "Check /tick endpoint returns 200 with regime != 'unknown'",
        "Verify watchdog.no_trade.state == 'OK' (will be OK since just started)",
        "Check regime classification shows diversity (confirms SIG-006 fix active)",
        "Verify scanner_ran: true in tick results (confirms A2 scanner decoupling)",
        "Check Alpaca dashboard: no orphaned pending orders from prior session"
      ],
      "indicators": [
        "regime != 'unknown' after tick 50",
        "signals_generated > 0 within first 100 ticks",
        "scanner_candidates_count > 0 after first scan interval",
        "watchdog.equity_fallback.current_streak == 0"
      ]
    },
    "midday_checks": {
      "frequency": "Once around 12:00-13:00 ET",
      "checks": [
        "Check watchdog.no_trade.state — should be 'OK' if any orders submitted today",
        "Check watchdog.no_trade.ticks_since_last_order — if > 2160, investigate",
        "Check watchdog.equity_fallback.total_fallback_count — should be low (<10)",
        "Check watchdog.universe_drift.drift_detected — should be false",
        "Check watchdog.brain_save.healthy — should be true",
        "Review /tmp/intra_trade_update_dlq.jsonl — should be empty or very small"
      ],
      "red_flags": [
        "watchdog.no_trade.state == 'WARNING_NO_TRADES' or 'CRITICAL_MULTI_SESSION'",
        "watchdog.equity_fallback.current_streak > 10",
        "watchdog.universe_drift.protected_missing not empty",
        "DLQ file has entries"
      ]
    },
    "post_close_checks": {
      "frequency": "After 16:15 ET daily",
      "checks": [
        "Check total trades for the day (should be > 0 for active market days)",
        "Check equity vs prior close (learning-mode losses expected but should be bounded)",
        "Verify brain saved successfully (brain_saved: true in last tick result)",
        "Check DLQ file (/tmp/intra_trade_update_dlq.jsonl)",
        "Verify no pending entries left overnight",
        "Check WebSocket reconnect count for the day"
      ],
      "indicators": [
        "Total daily trades: 5-30 expected in learning mode",
        "Daily PnL: -$500 to +$200 expected range (learning mode)",
        "Brain save: last save within 1 hour of close",
        "DLQ entries: 0 (ideal), <3 (acceptable)"
      ]
    },
    "exact_indicators_while_away": {
      "healthy": {
        "watchdog.no_trade.state": "OK",
        "watchdog.equity_fallback.current_streak": "0",
        "watchdog.universe_drift.drift_detected": false,
        "watchdog.brain_save.healthy": true,
        "signals_generated_per_day": "> 0",
        "orders_submitted_per_day": "> 0",
        "DLQ_entries": "0"
      },
      "concerning_but_not_critical": {
        "watchdog.no_trade.state": "WARNING_NO_TRADES",
        "watchdog.equity_fallback.total_fallback_count": "> 10 per day",
        "signals_generated_per_day": "0 for 1 day"
      },
      "requires_intervention": {
        "watchdog.no_trade.state": "CRITICAL_MULTI_SESSION (12+ hours no trades)",
        "watchdog.equity_fallback.current_streak": "> 25 (broker may be down)",
        "watchdog.universe_drift.protected_missing": "non-empty (SH/PSQ rotated despite protection)",
        "DLQ_entries": "> 10 (stream or DB failure)",
        "Docker_container_down": "api container exited"
      }
    }
  }
}
