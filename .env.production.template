# Production Environment Configuration
# Copy this file to .env.production and update with actual values

# Application Configuration - PRODUCTION
APP_ENVIRONMENT=production
APP_LOG_LEVEL=INFO
DEBUG=false

# Database Configuration - Update with production database URL
DATABASE_URL=postgresql+asyncpg://trading_user:CHANGE_DB_PASSWORD@localhost:5432/trading_platform
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=50
DATABASE_ECHO=false

# Alpaca Trading API - REPLACE WITH ACTUAL PRODUCTION CREDENTIALS
# Use ALPACA_API_KEY_ID and ALPACA_API_SECRET_KEY to match .env.paper format
ALPACA_API_KEY=CHANGE_TO_REAL_ALPACA_API_KEY
ALPACA_SECRET_KEY=CHANGE_TO_REAL_ALPACA_SECRET_KEY
ALPACA_API_KEY_ID=CHANGE_TO_REAL_ALPACA_API_KEY_ID
ALPACA_API_SECRET_KEY=CHANGE_TO_REAL_ALPACA_API_SECRET_KEY
ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets/v2
ALPACA_STREAM_URL=wss://api.alpaca.markets/stream

# Security Configuration - PRODUCTION JWT SECRET (64 characters)
JWT_SECRET_KEY=-su+!LL(*t2ej3Dk5LXyVwjRPctWyRDN#cYnJP3NwYniGVSiS9(!tL+4(9w_+^%D
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Observability Configuration
OTEL_SERVICE_NAME=algotrading-api-prod
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENABLED=true
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics

# Performance Configuration
PYTHONPATH=/app
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1