<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.intra.brain-backup</string>

    <!-- Daily at 16:30 in the Mac's local timezone (currently Pacific),
         after the equity session. Also capture a missed day's backup at login. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>16</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/marselkei/VS/intra</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/marselkei/VS/intra/venv/bin/python</string>
        <string>/Users/marselkei/VS/intra/scripts/runtime/rotate_brain_backup.py</string>
        <string>--keep</string>
        <string>30</string>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/marselkei/VS/intra/logs/brain_backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/marselkei/VS/intra/logs/brain_backup.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
