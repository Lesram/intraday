# Coverage configuration for the trading platform
# Sets coverage requirements and exclusions for CI/CD

[run]
source = backend
branch = True
parallel = True
omit = 
    */tests/*
    */legacy/*
    */__init__.py
    backend/**/migrations/*
    backend/**/generated/*

[report]
# Global minimum coverage requirement - targeting 40% initially
fail_under = 40
precision = 1
skip_covered = True
skip_empty = True
sort = cover
show_missing = True

# Exclude lines from coverage
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

[html]
directory = test_reports/coverage_html
title = Trading Platform Coverage Report

[xml]
output = test_reports/coverage.xml

[json]
output = test_reports/coverage.json

# Per-package minimum coverage requirements
# These are enforced in CI via coverage report analysis
[coverage:backend/risk]
fail_under = 85

[coverage:backend/services] 
fail_under = 85

[coverage:backend/api]
fail_under = 75

[coverage:backend/strategies]
fail_under = 80

# Package-specific coverage floors - targeting high coverage for critical modules
[coverage:paths]
source =
    backend/
    */backend/
