# Environment Variables - Example Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env with real secrets!

# Configuration Variables
# ACCOUNT_VALUE=<your_value>
# ALGO_PASS=<your_value>
# ALGO_USER=<your_value>
# ALLOW_ADMIN_OVERRIDE=<your_value>
# ALLOW_MOCK_FALLBACKS=<your_value>
# ALPACA=<your_value>
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets/v2
ALPACA_PAPER=true
ALPACA_RATE_LIMIT_PER_MINUTE=200
ALPACA_STREAM_URL=wss://paper-api.alpaca.markets/stream
# API_HOST=<your_value>
# API_PORT=<your_value>
# API_RATE_LIMIT_PER_MINUTE=<your_value>
# APP=<your_value>
APP_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
APP_ENV=paper
APP_ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_LOG_LEVEL=INFO
APP_PORT=8000
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FILE=audit_trail.log
# AUTO_PROMOTION_ENABLED=<your_value>
# AUTO_RETRAIN_ENABLED=<your_value>
# BASE_DELAY_MS=<your_value>
# BASE_URL=<your_value>
# BATCH_SIZE=<your_value>
# BOLLINGER_PERIOD=<your_value>
# BOLLINGER_STD=<your_value>
BROKER_HEALTH_TIMEOUT=10.0
# BROKER_IDEMPOTENCY_HEADER=<your_value>
BROKER_RETRY_DELAY_SECONDS=1
# CHAMPION_CHALLENGER_ENABLED=<your_value>
# CI=<your_value>
CIRCUIT_BREAKER_PCT=5.0
CIRCUIT_BREAKER_RECOVERY_TIME_MINUTES=15
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_WINDOW_MINUTES=5
CORS_ALLOW_ORIGINS=https://your-frontend-domain.com
# CORS_ORIGINS=<your_value>
DAILY_NOTIONAL_CAP_USD=10000
# DATA=<your_value>
# DATABASE=<your_value>
DATABASE_ECHO=false
DATABASE_MAX_OVERFLOW=50
DATABASE_POOL_SIZE=30
# DATABASE_URL=postgresql+asyncpg://trading:trading_password@localhost:5432/algotrading
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DATABASE_NAME
# DB_BACKUP_DIR=<your_value>
# DB_BACKUP_ENABLED=<your_value>
# DB_BACKUP_RETENTION_DAYS=<your_value>
DB_ECHO=false
# DB_ECHO_POOL=<your_value>
DB_MAX_OVERFLOW=20
# DB_POOL_PRE_PING=<your_value>
DB_POOL_RECYCLE=3600
DB_POOL_SIZE=10
# DB_POOL_TIMEOUT=<your_value>
DEBUG=true
DEFAULT_ORDER_TIMEOUT_SECONDS=30
# DEFAULT_SYMBOLS=<your_value>
# DEV_MODE=<your_value>
# DISABLE_ML=<your_value>
# DISABLE_TENSORFLOW=<your_value>
# DISABLE_TORCH=<your_value>
# DISABLE_TRANSFORMERS=<your_value>
# DISABLE_XGBOOST=<your_value>
# DRIFT_DETECTION_THRESHOLD=<your_value>
# DRIFT_PSI_ALERT=<your_value>
# DRIFT_PSI_WARN=<your_value>
# ECHO=<your_value>
# ENABLED=<your_value>
ENABLE_ADMIN_OVERRIDES=true
# ENABLE_AUTOCORR_FEATURES=<your_value>
ENABLE_BURN_RATE_ALERTS=true
ENABLE_DEBUG_ENDPOINTS=false
# ENABLE_HEAVY_FEATURES=<your_value>
# ENABLE_METRICS=<your_value>
# ENABLE_ML_MODELS=<your_value>
ENABLE_SWAGGER_UI=false
ENABLE_TEST_ROUTES=false
# ENSEMBLE_WEIGHTS=<your_value>
ENVIRONMENT=production
# FALLBACK_PORTFOLIO_VALUE=<your_value>
# FEATURE_MODE=<your_value>
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
# HEARTBEAT_INTERVAL=<your_value>
# HOST=<your_value>
# INFERENCE_LOG_MAX_ROWS=<your_value>
# INFERENCE_TELEMETRY_ENABLED=<your_value>
# JITTER_MS=<your_value>
JWT_ALGORITHM=HS256
JWT_AUD=algotrading-api
# JWT_AUDIENCE=<your_value>
# JWT_EXPIRATION_HOURS=<your_value>
JWT_EXPIRE_MINUTES=60
JWT_ISS=algotrading-platform
# JWT_ISSUER=<your_value>
JWT_REQUIRE_HTTPS=true
JWT_SECURE_COOKIES=true
# LATENCY_BUCKETS_MS=<your_value>
LOG_FORMAT=json
LOG_LEVEL=INFO
# LOG_TRACE_CORRELATION=<your_value>
# LSTM_WEIGHT=<your_value>
# MACD_FAST=<your_value>
# MACD_SIGNAL=<your_value>
# MACD_SLOW=<your_value>
# MAX_ATTEMPTS=<your_value>
MAX_BROKER_RETRIES=3
# MAX_CONNECTIONS=<your_value>
# MAX_DAILY_LOSS_PCT=<your_value>
MAX_DAILY_NOTIONAL_USD=10000.0
MAX_DAILY_ORDERS=100
MAX_DB_QUERY_TIME_MS=100
# MAX_DELAY_MS=<your_value>
# MAX_DRAWDOWN_PCT=<your_value>
# MAX_LEVERAGE=<your_value>
MAX_ORDERS_PER_MINUTE=10
MAX_ORDER_LATENCY_MS=1000
MAX_ORDER_SIZE=100
MAX_ORDER_SIZE_USD=1000.0
MAX_OUTBOX_QUEUE_DEPTH=100
# MAX_OVERFLOW=<your_value>
# MAX_POSITION_PCT=<your_value>
# MAX_POSITION_SIZE=<your_value>
# MAX_POSITION_VALUE=<your_value>
MAX_RESPONSE_TIME_MS=500
# MAX_ROLLING_WINDOW=<your_value>
# MAX_SYMBOL_EXPOSURE=<your_value>
# METRICS=<your_value>
METRICS_ENABLED=true
METRICS_PORT=9090
# METRIC_NAMESPACE=<your_value>
# MLOPS=<your_value>
# MOCK_FALLBACK_WARNING=<your_value>
MOCK_MARKET_DATA=false
MOCK_TIME_ACCELERATION=false
# MODEL_REGISTRY_PATH=<your_value>
# MOMENTUM_SCALE_FACTOR=<your_value>
# OBSERVABILITY=<your_value>
OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=<your_value>
# OTEL_EXPORTER_PROTOCOL=<your_value>
# OTEL_SAMPLER=<your_value>
# OTEL_SAMPLER_ARG=<your_value>
OTEL_SERVICE_NAME=algotrading-api-prod
OTEL_SERVICE_VERSION=1.0.0
# OUTBOX=<your_value>
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_RETRIES=3
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_PROCESSING_INTERVAL_SECONDS=5
OUTBOX_RETRY_BACKOFF=2.0
# PAPER=<your_value>
# PERF_ALERT_DROP=<your_value>
# PERF_EPSILON=<your_value>
# POLL_INTERVAL_MS=<your_value>
# POOL_SIZE=<your_value>
# POOL_TIMEOUT=<your_value>
# PORT=<your_value>
# PRODUCTION=<your_value>
# PROFILE=<your_value>
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics
PROMETHEUS_PORT=8000
# PYTEST_CURRENT_TEST=<your_value>
# PYTEST_RUNNING=<your_value>
PYTHONDONTWRITEBYTECODE=1
PYTHONPATH=/app
PYTHONUNBUFFERED=1
# RANDOM_FOREST_WEIGHT=<your_value>
RATE_LIMIT_PER_MINUTE=60
# RECONNECT_ATTEMPTS=<your_value>
# RECONNECT_DELAY=<your_value>
# REDDIT_CLIENT_ID=<your_value>
# REDDIT_USER_AGENT=<your_value>
# REDIS_DB=<your_value>
# REDIS_HOST=<your_value>
# REDIS_PORT=<your_value>
# REDIS_URL=<your_value>
# REGISTRY_ROOT=<your_value>
# REQUEST_TIMEOUT=<your_value>
# RETRAIN_DRIFT_THRESHOLD=<your_value>
RETRY_BASE_DELAY=1.0
RETRY_BROKER_ERRORS=true
RETRY_JITTER=true
RETRY_MAX_ATTEMPTS=3
RETRY_MAX_DELAY=60.0
# RISK=<your_value>
RISK_ALLOW_ADMIN_OVERRIDE=true
RISK_CIRCUIT_BREAKER_PCT=0.20
RISK_FALLBACK_PORTFOLIO_VALUE=250000.0
RISK_MAX_POSITION_VALUE=1.0
RISK_MAX_SYMBOL_EXPOSURE=0.60
RISK_PROFILE=relaxed
# RSI_PERIOD=<your_value>
# SECURITY=<your_value>
SECURITY_JWT_EXPIRE_MINUTES=60
# SENTIMENT_UPDATE_INTERVAL=<your_value>
# SKIP_VALIDATION=<your_value>
SLO_BROKER_API_P99_MS=500
SLO_ORDER_SUCCESS_RATE=0.999
SLO_STREAM_UPTIME=0.995
# STAGING=<your_value>
STREAM_MAX_BACKOFF=300
STREAM_RECONNECT_DELAY=5
STRUCTURED_LOGGING=true
# SUBREDDIT_LIST=<your_value>
SYMBOL_WHITELIST=AAPL,MSFT,GOOGL,TSLA,NVDA,SPY,QQQ
# TESTING=<your_value>
# TIMEZONE=<your_value>
# TRADING=<your_value>
TRADING_END_HOUR_ET=16
# TRADING_HOURS_END=<your_value>
# TRADING_HOURS_START=<your_value>
TRADING_PAUSED=false
TRADING_START_HOUR_ET=9
TRADING_WINDOW_END=21:00    # UTC (4:00 PM EST)
TRADING_WINDOW_START=14:30  # UTC (9:30 AM EST)
USE_MOCK_BROKER=false
USE_MOCK_DATA=false
# VERSION=<your_value>
# VOLATILITY_SCALE_FACTOR=<your_value>
# WEBSOCKET=<your_value>
WEBSOCKET_ENABLED=true
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=100
# WEBSOCKET_URL=<your_value>
# WITH_COV=<your_value>
# WORKERS=<your_value>
# XGBOOST_WEIGHT=<your_value>

# Secrets (NEVER commit real values)
# Admin User Credentials (for initial setup)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<your_strong_password>

# Alpaca API Credentials (STANDARD NAMES - use these!)
ALPACA_API_KEY_ID=<your_alpaca_api_key_id>
ALPACA_API_SECRET_KEY=<your_alpaca_api_secret_key>
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_STREAM_URL=wss://paper-api.alpaca.markets/stream

# Broker Configuration
USE_MOCK_BROKER=false  # Set to true for mock/testing, false for real Alpaca trading

# ============================================================================
# SECURITY SECRETS (REQUIRED - Must be set before deployment)
# ============================================================================
# Generate these with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# JWT secret key for token signing (REQUIRED)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_-c_import_secrets_print_secrets.token_urlsafe_32

# Alternative JWT secret environment variable (used by some modules)
SECURITY_JWT_SECRET=${JWT_SECRET_KEY}

# PostgreSQL password (REQUIRED for docker-compose)
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# Other API Credentials
# API_KEY=<your_secret_api_key>
# API_KEYS=<your_secret_api_keys>
# API_SECRET_KEY=<your_secret_api_secret_key>
# CORS_ALLOW_CREDENTIALS=<your_secret_cors_allow_credentials>
# JWT_ACCESS_TOKEN_EXPIRE_HOURS=<your_secret_jwt_access_token_expire_hours>
# REDDIT_CLIENT_SECRET=<your_secret_reddit_client_secret>
# SECRET_KEY=<your_secret_secret_key>
# STAGING_API_KEY=<your_secret_staging_api_key>
# TWITTER_API_KEY=<your_secret_twitter_api_key>
# TWITTER_API_SECRET=<your_secret_twitter_api_secret>
# TWITTER_BEARER_TOKEN=<your_secret_twitter_bearer_token>
