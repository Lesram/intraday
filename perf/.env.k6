# K6 Order Flow Performance Test Configuration

# Server Configuration
BASE_URL=http://localhost:8000
TEST_SYMBOL=AAPL
ORDER_QTY=10

# Authentication (choose one method)
# Method 1: Use staging API key (recommended)
STAGING_API_KEY=your_staging_api_key_here

# Method 2: Use login credentials (fallback)
# TEST_USERNAME=test_user
# TEST_PASSWORD=test_password

# Test Configuration
MAX_STATUS_RETRIES=5
STATUS_RETRY_DELAY=1.0

# Debug (optional)
# K6_DEBUG=true