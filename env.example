# Algorithmic Trading Platform Configuration
# Copy this file to .env and update with your actual credentials

# =============================================================================
# TRADING API CONFIGURATION
# =============================================================================
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER_TRADING=true

# =============================================================================
# SOCIAL MEDIA API CONFIGURATION (Optional)
# =============================================================================
# Twitter API v2 (for sentiment analysis)
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API (for sentiment analysis)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=AlgoTradingPlatform/1.0

# =============================================================================
# DATABASE AND CACHING
# =============================================================================
# Redis for caching and real-time data
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Database URL (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./trading_platform.db
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_platform

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# API secret key (CHANGE IN PRODUCTION!)
API_SECRET_KEY=your-super-secret-key-change-in-production-please
ALGORITHM=HS256

# JWT Security Settings
JWT_SECRET=your-jwt-secret-key-change-in-production-must-be-256-bits-long
JWT_ALGORITHM=HS256
JWT_ISSUER=algotrading-platform
JWT_AUDIENCE=algotrading-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security Mode (set to false in production)
SECURITY_DEV_MODE=true

# API Keys for Machine-to-Machine Authentication (comma-separated)
# Example: API_KEYS=key1,key2,key3
API_KEYS=dev-api-key-123,another-api-key-456

# =============================================================================
# RISK MANAGEMENT PARAMETERS
# =============================================================================
# Maximum daily loss as percentage of portfolio
MAX_DAILY_LOSS_PCT=0.03

# Maximum drawdown before emergency procedures
MAX_DRAWDOWN_PCT=0.06

# Maximum position size as percentage of portfolio
MAX_POSITION_PCT=0.1

# Maximum leverage allowed
MAX_LEVERAGE=2.0

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
# Trading hours (Eastern Time)
TRADING_HOURS_START=09:30
TRADING_HOURS_END=16:00
TIMEZONE=America/New_York

# Default symbols to track
DEFAULT_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,BTC/USD,ETH/USD

# =============================================================================
# AI/ML MODEL CONFIGURATION
# =============================================================================
# Ensemble model weights
LSTM_WEIGHT=0.4
XGBOOST_WEIGHT=0.4
RANDOM_FOREST_WEIGHT=0.2

# Model drift detection threshold
DRIFT_DETECTION_THRESHOLD=0.05

# Model registry path
MODEL_REGISTRY_PATH=backend/models/saved_models

# =============================================================================
# TECHNICAL INDICATORS CONFIGURATION
# =============================================================================
# RSI parameters
RSI_PERIOD=14

# MACD parameters
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Bollinger Bands parameters
BOLLINGER_PERIOD=20
BOLLINGER_STD=2.0

# =============================================================================
# SENTIMENT ANALYSIS CONFIGURATION
# =============================================================================
# Subreddit list for Reddit sentiment
SUBREDDIT_LIST=StockMarket,investing,wallstreetbets,cryptocurrency,Bitcoin

# Sentiment update interval (seconds)
SENTIMENT_UPDATE_INTERVAL=300

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Prometheus metrics port
PROMETHEUS_PORT=8000

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Number of worker processes
WORKERS=4

# Maximum connections per worker
MAX_CONNECTIONS=1000

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# =============================================================================
# MLOPS CONFIGURATION (Branch 2.6)
# =============================================================================
# Model Registry Settings
MLOPS_REGISTRY_ROOT=artifacts
MLOPS_INFERENCE_TELEMETRY_ENABLED=true

# Drift Detection Thresholds
MLOPS_DRIFT_PSI_WARN=0.1
MLOPS_DRIFT_PSI_ALERT=0.25
MLOPS_PERF_EPSILON=0.01
MLOPS_PERF_ALERT_DROP=0.05

# Inference Telemetry Settings
MLOPS_INFERENCE_LOG_MAX_ROWS=200000

# Model Deployment Settings
MLOPS_AUTO_PROMOTION_ENABLED=false
MLOPS_CHAMPION_CHALLENGER_ENABLED=true

# Retraining Settings
MLOPS_AUTO_RETRAIN_ENABLED=false
MLOPS_RETRAIN_DRIFT_THRESHOLD=0.7
