# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=http://localhost:8000

# Application
VITE_APP_NAME=AlgoTrading Platform
VITE_APP_VERSION=1.0.0

# Feature Flags (enable/disable features)
VITE_ENABLE_TRADING=true
VITE_ENABLE_ML_MODELS=true
VITE_ENABLE_STRATEGIES=true

# External Services (if needed)
# VITE_TRADINGVIEW_API_KEY=your_key_here
# VITE_AG_GRID_LICENSE_KEY=your_license_key_here
